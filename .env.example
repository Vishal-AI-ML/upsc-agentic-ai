# ============================================================================
# UPSC Agentic AI — BACKEND environment variables (root .env.example)
# Copy to .env and fill in. NEVER commit the real .env.
# Only a handful are REQUIRED to boot; everything else is optional/fail-open.
# ============================================================================

# ----- Deployment environment -----
# production | staging | development  (authoritative for security gates)
ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ----- REQUIRED: Auth -----
# 32+ char random secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Email verification requires SMTP; keep false unless SMTP_* are set.
REQUIRE_EMAIL_VERIFICATION=false

# ----- REQUIRED: Database (Postgres in prod, SQLite auto-fallback if empty) -----
# Supabase (use the POOLER/6543 URL for free tier) or Neon pooled URL.
#   postgresql://user:pass@host:6543/postgres?sslmode=require
DATABASE_URL=

# ----- REQUIRED: Primary LLM (Google Gemini) -----
# Free key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# ----- Recommended: Fallback LLM (Groq, free) — kicks in on Gemini 429 -----
# Free key: https://console.groq.com
GROQ_API_KEY=
ENABLE_PROVIDER_FALLBACK=true

# ----- Vector store (Qdrant managed). Empty => local Chroma fallback -----
# Free 1GB cluster: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=
SIMILARITY_THRESHOLD=0.3
MENTOR_KB_THRESHOLD=0.25

# ----- Embeddings (keep 'gemini' on 512MB free tiers to avoid OOM) -----
# gemini | local | ollama | openai_compat
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=models/gemini-embedding-001

# ----- Web search (optional; DuckDuckGo used if empty) -----
# Free key: https://tavily.com
TAVILY_API_KEY=

# ----- Response cache + jobs (Upstash Redis, free) -----
# REST creds power the response cache; REDIS_URL (TCP) powers rq workers.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESPONSE_CACHE_ENABLED=true
REDIS_URL=
JOBS_BACKEND=auto

# ----- CORS (JSON array!) must include your deployed frontend origin -----
# Example: CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173"]

# ----- Observability: Langfuse (optional, free) -----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ----- Error monitoring: Sentry (optional, free 5k errors/mo) -----
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ----- Email / SMTP (optional; password reset + verification) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# ----- Rate limiting -----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_PERIOD=300

# ----- Uploads -----
MAX_UPLOAD_MB=20

# ----- Admin allowlist (JSON array of emails for cost/monitoring dashboards) -----
ADMIN_EMAILS=[]

# ----- Runtime tuning -----
WEB_CONCURRENCY=1
